#!/usr/bin/env bash
# Fake `orca` CLI for tests/runtime.sh. Put this directory FIRST on PATH.
#
# A PATH shim (not a shell function) is required: orca-dispatch-role.sh nohups
# the reaper as a separate process, and functions are not inherited.
#
# All state lives under $FAKE_ORCA_STATE (one tmpdir per test):
#   calls.log          one line per invocation — the main assertion surface
#   counter            monotonic id source for term_/task_/disp_ ids
#   terminals          "<handle>\t<title>" per live terminal
#   sends/<handle>     concatenated `terminal send --text` bodies (seed assertions)
#   preview/<handle>   text returned by `terminal show` (limit-pattern tests)
#   status/<task_id>   dispatch status; default "dispatched"
#   workerstate/<dispatch_id>  worker-show worker.state; default "running"
#   releasestate/<dispatch_id> worker-release result; default "retained"
#                      (matches references/orca-contract-2026-08-13.md S1-a's
#                      measured default for a pre-created custom-argv
#                      terminal — set to "released" to test the native path)
#   acks               one line per `check --ack <id>` call (ack assertions)
#   check.json         canned `orchestration check --wait` payload
#   wt.tsv             "<path>\t<name>\t<branch>\t<isMain 0|1>" per worktree
#                      created via `worktree create` (path = $STATE/worktrees/<name>, a real dir)
#   mainworktree       optional "<path>\t<branch>" for the main-worktree row
#                      that `worktree list` / `worktree ps` always include
#   termwt/<handle>    worktree selector a terminal was created in
#                      (`worktree rm` closes every terminal in that worktree)
#   wtset.log          one line per `worktree set` call (comment/status asserts)
#   fail/<key>         FAILURE INJECTION. Presence makes that subcommand fail.
#                      key = subcommand with spaces as dashes: status,
#                      terminal-list, terminal-close, terminal-create,
#                      dispatch-show, check, worker-start, worker-show,
#                      worker-release, worker-stop, worktree-create,
#                      worktree-list, worktree-show, worktree-rm, worktree-set,
#                      worktree-ps, file-open-changed, file-diff, host-list,
#                      goto, screenshot, terminal-switch
#                      body = "garbage" (emit non-JSON, exit 0) or anything
#                      else / empty (exit 1). Default: exit 1.
set -uo pipefail

STATE="${FAKE_ORCA_STATE:?FAKE_ORCA_STATE must be set}"
mkdir -p "$STATE" "$STATE/sends" "$STATE/preview" "$STATE/status" "$STATE/fail" "$STATE/cli" "$STATE/screen" "$STATE/termwt"
touch "$STATE/calls.log" "$STATE/terminals" "$STATE/wt.tsv"

printf '%s\n' "$*" >>"$STATE/calls.log"

# Read the value following a flag, e.g. flag_val --terminal "$@"
flag_val() {
  local want="$1"; shift
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "$want" ]]; then
      printf '%s' "${2:-}"
      return 0
    fi
    shift
  done
  return 0
}

next_id() {
  local n
  n="$(cat "$STATE/counter" 2>/dev/null || echo 0)"
  n=$((n + 1))
  printf '%s' "$n" >"$STATE/counter"
  printf '%s' "$n"
}

# Honour an injected failure for this subcommand key. Returns non-zero (and
# emits) only when the caller should stop; otherwise falls through.
maybe_fail() {
  local key="$1" f="$STATE/fail/$1" mode
  [[ -e "$f" ]] || return 0
  mode="$(cat "$f" 2>/dev/null || true)"
  if [[ "$mode" == "garbage" ]]; then
    printf 'not json — %s is broken\n' "$key"
    exit 0
  fi
  echo "fake-orca: injected failure for $key" >&2
  exit 1
}

SUB1="${1:-}"
SUB2="${2:-}"

case "$SUB1 $SUB2" in
  "status "*)
    # The match word "$SUB1 $SUB2" always has an embedded space (even when
    # $SUB2 is empty, giving "status "), so a bare "status" alternative here
    # could never match — this pattern alone covers every case.
    maybe_fail status
    # bootstrap greps the literal string '"reachable": true' (json.dumps indent style)
    cat <<'JSON'
{
  "result": {
    "runtime": {
      "reachable": true
    }
  }
}
JSON
    ;;

  "terminal create")
    maybe_fail terminal-create
    handle="term_$(next_id)"
    title="$(flag_val --title "$@")"
    cmd="$(flag_val --command "$@")"
    printf '%s\t%s\n' "$handle" "$title" >>"$STATE/terminals"
    # Record which CLI this handle is "running" so `terminal read` can answer
    # the readiness gate (_terminal_ready_check in orca-roles-lib.sh) with a
    # screen shaped correctly for that CLI — first word of the launch command.
    mkdir -p "$STATE/cli"
    printf '%s' "${cmd%% *}" >"$STATE/cli/$handle"
    printf '%s' "$(flag_val --worktree "$@")" >"$STATE/termwt/$handle"
    printf '{"result":{"handle":"%s","title":"%s"}}\n' "$handle" "$title"
    ;;

  "terminal rename")
    maybe_fail terminal-rename
    printf '{"result":{"ok":true}}\n'
    ;;

  "terminal wait")
    maybe_fail terminal-wait
    printf '{"result":{"state":"tui-idle"}}\n'
    ;;

  "terminal send")
    maybe_fail terminal-send
    h="$(flag_val --terminal "$@")"
    flag_val --text "$@" >>"$STATE/sends/${h:-unknown}"
    # seed() (orca-roles-lib.sh) accepts EITHER result.send.accepted or a
    # top-level "ok" — top-level is what the real API returns (see the
    # terminal-read handler's comment on the same point).
    printf '{"ok":true,"result":{"ok":true}}\n'
    ;;

  "terminal list")
    maybe_fail terminal-list
    # --worktree filters by the selector recorded at `terminal create` time
    # (termwt/<handle>); without it, every live terminal is listed.
    # No $(flag_val …) subshell here: this arm is on the reaper's hot path
    # (terminal_is_live polls it, R5 runs 8 reapers against a 3s budget), so
    # the flag is pulled out of the raw argv inside the one python process.
    python3 - "$STATE/terminals" "$STATE/termwt" "$@" <<'PY'
import json, os, sys
path, termwt_dir = sys.argv[1:3]
argv = sys.argv[3:]
want = argv[argv.index("--worktree") + 1] if "--worktree" in argv and argv.index("--worktree") + 1 < len(argv) else ""
terminals = []
with open(path) as stream:
    for line in stream:
        line = line.rstrip("\n")
        if not line:
            continue
        handle, _, title = line.partition("\t")
        if want:
            try:
                sel = open(os.path.join(termwt_dir, handle)).read().strip()
            except Exception:
                sel = ""
            if sel != want:
                continue
        terminals.append({"handle": handle, "title": title, "connected": True})
print(json.dumps({"result": {"terminals": terminals}}))
PY
    ;;

  "terminal close")
    maybe_fail terminal-close
    h="$(flag_val --terminal "$@")"
    python3 - "$STATE/terminals" "$h" <<'PY'
import sys
path, handle = sys.argv[1:3]
with open(path) as stream:
    kept = [ln for ln in stream if ln.partition("\t")[0] != handle]
with open(path, "w") as stream:
    stream.writelines(kept)
PY
    printf '{"result":{"closed":"%s"}}\n' "$h"
    ;;

  "terminal show")
    maybe_fail terminal-show
    h="$(flag_val --terminal "$@")"
    python3 - "$STATE/preview/${h:-none}" <<'PY'
import json, os, sys
path = sys.argv[1]
preview = open(path).read() if os.path.exists(path) else ""
print(json.dumps({"result": {"terminal": {"preview": preview}}}))
PY
    ;;

  "terminal read")
    maybe_fail terminal-read
    h="$(flag_val --terminal "$@")"
    # Two test-only overrides, checked before the default cli-keyed screen
    # below (used by the idle-detection tests, R9/R11 — see tests/runtime.sh):
    #   screen/<handle>.dynamic  — presence means "return DIFFERENT tail
    #     content on every call", simulating a genuinely still-generating
    #     model. A counter file tracks call count so consecutive reads never
    #     produce an identical normalized screen.
    #   screen/<handle>          — a static, literal tail (one line per file
    #     line), for a screen that must never change across calls.
    if [[ -f "$STATE/screen/${h:-none}.dynamic" ]]; then
      n="$(cat "$STATE/screen/${h}.counter" 2>/dev/null || echo 0)"
      n=$((n + 1))
      printf '%s' "$n" >"$STATE/screen/${h}.counter"
      python3 - "$h" "$n" <<'PY'
import json, sys
handle, n = sys.argv[1], sys.argv[2]
print(json.dumps({
    "ok": True,
    "result": {
        "terminal": {"handle": handle, "status": "running", "tail": [f"still generating chunk {n}", "❯ "]},
    },
}))
PY
    elif [[ -f "$STATE/screen/${h:-none}" ]]; then
      python3 - "$h" "$STATE/screen/${h}" <<'PY'
import json, sys
handle, path = sys.argv[1], sys.argv[2]
with open(path) as f:
    lines = f.read().splitlines()
print(json.dumps({
    "ok": True,
    "result": {"terminal": {"handle": handle, "status": "running", "tail": lines}},
}))
PY
    else
      cli="$(cat "$STATE/cli/${h:-none}" 2>/dev/null || echo "")"
      # A screen shaped to satisfy _terminal_ready_check's positive pattern for
      # each CLI on the FIRST read, so the readiness gate inside seed() passes
      # immediately instead of polling out to ROLE_READY_TIMEOUT_SECONDS.
      python3 - "$h" "$cli" <<'PY'
import json, sys
handle, cli = sys.argv[1], sys.argv[2]
# Keyed on the CLI binary (recorded at `terminal create` time from the launch
# command's first word), but seed()/_terminal_ready_check select behaviour by
# AGENT name (role_meta's 3rd field) — "agy" the binary vs. "antigravity" the
# agent for ui/fallback/debater_gemini. Cover both spellings.
lines = {
    "claude": ["bypass permissions on", "❯ "],
    "grok":   ["❯ "],
    "agy": [">"], "antigravity": [">"],
}.get(cli, ["$ "])  # codex (and unknown): no positive pattern is required
# "ok" is a TOP-LEVEL field (sibling of "result"), matching the real API —
# _terminal_ready_check checks d.get("ok") on the outer object, not inside
# "result". Nesting it there (as most other fake handlers here do for THEIR
# own consumers) made every terminal read as unreadable regardless of CLI.
print(json.dumps({
    "ok": True,
    "result": {
        "terminal": {"handle": handle, "status": "running", "tail": lines},
    },
}))
PY
    fi
    ;;

  "orchestration task-create")
    maybe_fail task-create
    printf '{"result":{"task":{"id":"task_%s"}}}\n' "$(next_id)"
    ;;

  "orchestration dispatch")
    maybe_fail dispatch
    printf '{"result":{"dispatch":{"id":"disp_%s"}}}\n' "$(next_id)"
    ;;

  "orchestration dispatch-show")
    maybe_fail dispatch-show
    t="$(flag_val --task "$@")"
    st="$(cat "$STATE/status/${t:-none}" 2>/dev/null || echo dispatched)"
    printf '{"result":{"dispatch":{"id":"disp_x","status":"%s"}}}\n' "$st"
    ;;

  "orchestration worker-start")
    maybe_fail worker-start
    mkdir -p "$STATE/workerstate"
    d="ctx_$(next_id)"
    printf '{"result":{"dispatchId":"%s","taskId":"%s","state":"ready","stage":"input_accepted","effects":[]}}\n' \
      "$d" "$(flag_val --task "$@")"
    ;;

  "orchestration worker-show")
    maybe_fail worker-show
    d="$(flag_val --dispatch "$@")"
    ws="$(cat "$STATE/workerstate/${d:-none}" 2>/dev/null || echo running)"
    printf '{"result":{"worker":{"state":"%s"},"dispatch":{"status":"dispatched"}}}\n' "$ws"
    ;;

  "orchestration worker-release")
    maybe_fail worker-release
    d="$(flag_val --dispatch "$@")"
    st="$(cat "$STATE/releasestate/${d:-none}" 2>/dev/null || echo retained)"
    if [[ "$st" == "released" ]]; then
      # Realistic: a real native release actually closes the terminal. Find
      # it by dispatch id via the ledger the caller passed --dispatch for —
      # simplest is the caller also tells us the handle via the ledger, but
      # this fake has no ledger access, so tests using "released" pass the
      # handle to close via $STATE/releasehandle/<dispatch_id> (optional).
      h="$(cat "$STATE/releasehandle/${d:-none}" 2>/dev/null || echo "")"
      if [[ -n "$h" ]]; then
        python3 - "$STATE/terminals" "$h" <<'PY'
import sys
path, handle = sys.argv[1:3]
with open(path) as stream:
    kept = [ln for ln in stream if ln.partition("\t")[0] != handle]
with open(path, "w") as stream:
    stream.writelines(kept)
PY
      fi
      printf '{"result":{"dispatchId":"%s","state":"released","archive":{"status":"ok"}}}\n' "$d"
    else
      printf '{"result":{"dispatchId":"%s","state":"%s","reason":"external_terminal","archive":null}}\n' "$d" "$st"
    fi
    ;;

  "orchestration check")
    maybe_fail check
    ack="$(flag_val --ack "$@")"
    if [[ -n "$ack" ]]; then
      printf '%s\n' "$ack" >>"$STATE/acks"
      printf '{"result":{"acknowledged":"%s"}}\n' "$ack"
      exit 0
    fi
    if [[ -f "$STATE/check.json" ]]; then
      cat "$STATE/check.json"
      # `orchestration check` is destructive against the real inbox — a
      # message it returns is consumed, not handed back again on the next
      # call. Serving this fixture only once matches that: a test polling in
      # a tight loop (no matching task id, no sleep between iterations —
      # see orca-wait-done.sh) would otherwise pile up duplicate "spooled"
      # copies of a message that, in reality, is only ever delivered once.
      rm -f "$STATE/check.json"
    else
      printf '{"result":{"count":0,"messages":[]}}\n'
    fi
    ;;

  "terminal switch")
    maybe_fail terminal-switch
    printf '{"ok":true,"result":{"switched":"%s"}}\n' "$(flag_val --terminal "$@")"
    ;;

  "orchestration worker-stop")
    maybe_fail worker-stop
    printf '{"ok":true,"result":{"dispatchId":"%s","state":"failed","alreadySettled":false,"processAction":"none"}}\n' "$(flag_val --dispatch "$@")"
    ;;

  # --- worktrees (shapes measured in references/orca-recipes-spike-2026-09-14.md)
  "worktree create")
    maybe_fail worktree-create
    name="$(flag_val --name "$@")"
    base="$(flag_val --base-branch "$@")"
    wpath="$STATE/worktrees/${name:-unnamed}"
    mkdir -p "$wpath"
    printf '%s\t%s\t%s\t0\n' "$wpath" "$name" "refs/heads/fake/$name" >>"$STATE/wt.tsv"
    python3 - "$wpath" "$name" "${base:-main}" <<'PY'
import json, sys
path, name, base = sys.argv[1:4]
print(json.dumps({"ok": True, "result": {"worktree": {
    "id": "repo_fake::" + path, "path": path, "branch": "refs/heads/fake/" + name,
    "baseRef": base, "isMainWorktree": False, "displayName": name, "comment": ""},
    "warnings": []}}))
PY
    ;;

  "worktree list"|"worktree ps")
    maybe_fail "worktree-$SUB2"
    python3 - "$STATE/wt.tsv" "$STATE/mainworktree" "$STATE/terminals" "$STATE/termwt" "$SUB2" <<'PY'
import json, os, sys
wt_path, main_path, terms_path, termwt_dir, sub = sys.argv[1:6]
rows = []
main = ("/fake/main", "refs/heads/main")
if os.path.exists(main_path):
    p, _, b = open(main_path).read().strip().partition("\t")
    main = (p, b or "refs/heads/main")
rows.append((main[0], "main", main[1], True))
with open(wt_path) as f:
    for line in f:
        line = line.rstrip("\n")
        if not line:
            continue
        p, n, b, m = (line.split("\t") + ["", "", "0"])[:4]
        rows.append((p, n, b, m == "1"))
live = {}
handles = [ln.partition("\t")[0] for ln in open(terms_path) if ln.strip()]
for h in handles:
    try:
        sel = open(os.path.join(termwt_dir, h)).read().strip()
    except Exception:
        sel = ""
    live[sel] = live.get(sel, 0) + 1
out = []
for p, n, b, m in rows:
    row = {"path": p, "displayName": n, "branch": b, "isMainWorktree": m,
           "repoId": "repo_fake", "comment": "", "workspaceStatus": "in-progress"}
    if sub == "ps":
        row.update({"worktreeId": "repo_fake::" + p, "liveTerminalCount": live.get("path:" + p, 0),
                    "status": "active", "agents": []})
    else:
        row["id"] = "repo_fake::" + p
    out.append(row)
print(json.dumps({"ok": True, "result": {"worktrees": out, "totalCount": len(out), "truncated": False}}))
PY
    ;;

  "worktree show")
    maybe_fail worktree-show
    sel="$(flag_val --worktree "$@")"
    python3 - "$STATE/wt.tsv" "$STATE/mainworktree" "$sel" <<'PY'
import json, os, sys
wt_path, main_path, sel = sys.argv[1:4]
want = sel[len("path:"):] if sel.startswith("path:") else sel
main = "/fake/main"
if os.path.exists(main_path):
    main = open(main_path).read().strip().partition("\t")[0]
if want in ("active", "current") or want == main:
    print(json.dumps({"ok": True, "result": {"worktree": {"path": main, "isMainWorktree": True}}}))
    sys.exit(0)
with open(wt_path) as f:
    for line in f:
        p, n, b, m = (line.rstrip("\n").split("\t") + ["", "", "0"])[:4]
        if p == want or n == want:
            print(json.dumps({"ok": True, "result": {"worktree": {
                "id": "repo_fake::" + p, "path": p, "branch": b, "isMainWorktree": m == "1"}}}))
            sys.exit(0)
print(json.dumps({"ok": False, "error": {"code": "worktree_not_found", "message": want}}))
sys.exit(1)
PY
    ;;

  "worktree rm")
    maybe_fail worktree-rm
    sel="$(flag_val --worktree "$@")"
    python3 - "$STATE/wt.tsv" "$STATE/terminals" "$STATE/termwt" "$sel" <<'PY'
import os, sys
wt_path, terms_path, termwt_dir, sel = sys.argv[1:5]
want = sel[len("path:"):] if sel.startswith("path:") else sel
kept = []
removed = False
with open(wt_path) as f:
    for line in f:
        if not line.strip():
            continue
        if line.split("\t")[0] == want:
            removed = True
            continue
        kept.append(line)
with open(wt_path, "w") as f:
    f.writelines(kept)
# Measured live: rm --force closes every terminal in the worktree.
kept_t = []
with open(terms_path) as f:
    for line in f:
        h = line.partition("\t")[0]
        try:
            sel_h = open(os.path.join(termwt_dir, h)).read().strip()
        except Exception:
            sel_h = ""
        if sel_h == "path:" + want:
            continue
        kept_t.append(line)
with open(terms_path, "w") as f:
    f.writelines(kept_t)
print('{"ok":true,"result":{"removed":%s}}' % ("true" if removed else "false"))
PY
    ;;

  "worktree set")
    maybe_fail worktree-set
    printf '%s\n' "$*" >>"$STATE/wtset.log"
    printf '{"ok":true,"result":{"updated":true}}\n'
    ;;

  "worktree current")
    maybe_fail worktree-current
    printf '{"ok":true,"result":{"worktree":{"path":"/fake/main","isMainWorktree":true}}}\n'
    ;;

  "file open-changed"|"file diff"|"file open")
    maybe_fail "file-$SUB2"
    printf '{"ok":true,"result":{"opened":true}}\n'
    ;;

  "host list")
    maybe_fail host-list
    printf '{"ok":true,"result":{"hosts":[{"kind":"local","name":"this machine","id":"local","selector":"--host local","platform":"darwin"}]}}\n'
    ;;

  "goto "*)
    maybe_fail goto
    printf '{"ok":true,"result":{"url":"%s"}}\n' "$(flag_val --url "$@")"
    ;;

  "screenshot "*)
    maybe_fail screenshot
    printf '{"ok":true,"result":{"path":"/fake/screenshot.png"}}\n'
    ;;

  *)
    echo "fake-orca: unhandled subcommand: $SUB1 $SUB2" >&2
    exit 64
    ;;
esac
exit 0
