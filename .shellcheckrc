# SC1091: sourced files are resolved at runtime from the INSTALLED path
#         (.orca/orchestration/scripts/), not from the repo layout. The
#         `# shellcheck source=` directives already name the real target.
disable=SC1091

# SC2294: the assert() helpers in tests/ take a condition as a string on
#         purpose so the failing expression can be printed verbatim.
disable=SC2294

# SC2317: same root cause as SC2294 above — helper functions in tests/ are
#         invoked only from inside strings that assert() later eval's, never
#         as a direct call shellcheck's flow analysis can see.
disable=SC2317
